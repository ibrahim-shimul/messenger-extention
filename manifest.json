{
  "manifest_version": 3,
  "name": "Messenger Workspace",
  "description": "A presentation-only workspace enhancement for Facebook Messenger",
  "version": "1.0.0",
  "action": {
    "default_title": "Messenger Workspace Settings",
    "default_popup": "src/settings/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.messenger.com/*",
    "*://www.facebook.com/messages/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.messenger.com/*",
        "*://www.facebook.com/messages/*"
      ],
      "js": [
        "src/content/bootstrap.js",
        "src/content/selector-adapter.js",
        "src/content/observer-coordinator.js",
        "src/shared/diagnostics.js",
        "src/shared/storage-service.js",
        "src/features/theme-engine.js",
        "src/features/layout-enhancer.js",
        "src/settings/settings-ui.js",
        "src/content/preferences-bridge.js"
      ],
      "css": [
        "src/styles/theme-tokens.css",
        "src/styles/layout.css",
        "src/styles/chatgpt-style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}